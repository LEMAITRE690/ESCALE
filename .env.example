# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application
NEXT_PUBLIC_SITE_URL=https://escale.app

# Stripe (paiement carte + abonnement hôte)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Prix récurrent de la formule Abonnement (19 €/mois TTC).
# Obtenu en lançant : node scripts/creer-produit-abonnement.mjs
STRIPE_SUBSCRIPTION_PRICE_ID=

# Pay by Bank / Lemonway
# Laisser false tant que le contrat PSP, le wallet de collecte et les callbacks
# Lemonway ne sont pas configurés dans l'environnement cible.
NEXT_PUBLIC_PAY_BY_BANK_ENABLED=false
LEMONWAY_SANDBOX=true
LEMONWAY_ENV_NAME=
# Clé Basic générée dans Dashboard > Developers > API Keys.
LEMONWAY_API_KEY=
# Facultatif : bearer déjà provisionné. S'il est absent, ESCALE l'obtient via OAuth.
LEMONWAY_ACCESS_TOKEN=
# Payment Account / wallet Lemonway prévu contractuellement pour recevoir les Money-In.
LEMONWAY_COLLECTION_ACCOUNT_ID=
# À renseigner lorsque les webhooks Lemonway seront activés avec l'équipe d'implémentation.
LEMONWAY_WEBHOOK_SECRET=

# Sécurise les routes /api/cron/*
CRON_SECRET=

# Recherche IA
ANTHROPIC_API_KEY=
